# Google Routes API
# Nunca subas tu clave real al repositorio.
GOOGLE_MAPS_API_KEY=TU_API_KEY_AQUI

ROUTING_PREFERENCE=TRAFFIC_AWARE
REQUEST_DELAY_MS=300
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
DISTANCE_TOLERANCE_PCT=60

# ============================================================
# RECOLECCIÓN AUTOMÁTICA
# ============================================================
# Incluye ambos extremos: 06:00, 07:00, ..., 18:00.
SCHEDULE_START_HOUR=6
SCHEDULE_END_HOUR=18

# Día(s) de la semana según cron:
# 1       = solo lunes
# 1-5     = lunes a viernes
# *       = todos los días
# 0,6     = domingo y sábado
SCHEDULE_DAYS=1-5
SCHEDULE_TIMEZONE=America/Bogota

# true sirve para probar el despliegue inmediatamente.
# En producción se recomienda false para no crear una medición fuera de horario.
RUN_ON_START=false

# En Railway monta un volumen en /app/data y usa DATA_DIR=/app/data
# En local puedes dejar DATA_DIR vacío para usar ./data
DATA_DIR=

# Servidor web para descargar los archivos.
# Railway define PORT automáticamente; localmente se usa 3000.
PORT=3000

# Define un token largo para que los archivos no queden públicos.
DOWNLOAD_TOKEN=CAMBIA_ESTE_TOKEN_POR_UNO_LARGO_Y_ALEATORIO
